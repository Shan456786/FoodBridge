# ---- Browser (public) -------------------------------------------------
# Supabase → Project Settings → API. The anon/publishable key is safe to expose;
# Row Level Security and database functions enforce all permissions.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Operator machine only (NEVER prefix with VITE_, NEVER commit) -----
# Used by `npm run seed:demo` to create demo accounts and seed demo data.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: used by `npm run db:migrate` (Project Settings → Database → Session pooler URI)
DATABASE_URL=
# Optional: must match src/lib/demo.ts if changed
# DEMO_PASSWORD=FoodBridge-Demo-2026
